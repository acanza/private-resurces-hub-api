# Application
ENVIRONMENT=local

# AWS credentials
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS resources
AWS_S3_BUCKET=your-s3-bucket-name
AWS_DYNAMODB_TABLE=your-dynamodb-table-name

# CloudFront signed cookies
AWS_CF_DISTRIBUTION_DOMAIN=d123456789abcde.cloudfront.net
AWS_CF_KEY_PAIR_ID=APKAXXXXXXXXXX
# PEM private key content (newlines replaced with \n for single-line env var)
AWS_CF_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
AWS_CF_COOKIE_MAX_AGE_SECONDS=3600
