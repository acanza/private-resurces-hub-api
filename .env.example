# Application
ENVIRONMENT=local

# AWS credentials
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS resources
S3_BUCKET_NAME=your-s3-bucket-name
DYNAMODB_TABLE_NAME=your-dynamodb-table-name

# CloudFront signed cookies
PRIVATE_DISTRIBUTION_DOMAIN_NAME=d123456789abcde.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=APKAXXXXXXXXXX
# Name of the secret in AWS Secrets Manager that holds the CloudFront RSA private key 
CF_SECRET_NAME=prh/dev/cloudfront-private-key
CF_COOKIE_MAX_AGE_SECONDS=3600
